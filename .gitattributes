# 统一行尾为 LF，避免 Windows 检出时把 CRLF 混入 YAML / 模板
* text=auto eol=lf

# 二进制资源严禁行尾转换（否则 PDF / 图片会被 Git 破坏）
*.pdf   binary
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.zip   binary

# 文本类明确使用 LF
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
*.toml  text eol=lf
*.bib   text eol=lf
