# 本地可选环境变量（复制为 .env 后填写；.env 不会被提交）
# 所有项都是可选的，不填也能正常同步。

# ORCID iD（默认已写入脚本，无需修改）
ORCID_ID=0009-0003-6832-3957

# 联系邮箱：进入 OpenAlex polite pool，请求更稳定（推荐填写）
POLITE_EMAIL=you@example.com

# OpenAlex 免费 API Key：提升每日请求额度（可选）
# 获取方式：https://openalex.org/settings/api
OPENALEX_API_KEY=

# 若 OpenAlex 自动匹配到错误的同名作者，可手动指定作者 ID（逗号分隔）
# 例如：OPENALEX_AUTHOR_IDS=A5103083652,A5126642634,A5136674440
OPENALEX_AUTHOR_IDS=

# Cloudflare（仅方案 B 使用）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
