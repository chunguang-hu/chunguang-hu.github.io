# ---- Hugo 构建产物 ----
/public/
/resources/
/_gen/
.hugo_build.lock

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 本地环境变量（不要提交密钥） ----
.env
.env.local

