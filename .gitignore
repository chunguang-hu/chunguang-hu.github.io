.cache/
scripts/.cache/
*.log

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Node（仅 wrangler 本地部署时使用，非站点运行依赖） ----
node_modules/
.wrangler/
